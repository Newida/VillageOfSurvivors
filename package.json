{
  "name": "nightfall-village",
  "version": "1.0.0",
  "private": true,
  "description": "A player-hosted co-op server for Nightfall Village.",
  "author": "Lukas Theißinger",
  "license": "SEE LICENSE IN LICENSING.md",
  "main": "src/desktop/main.js",
  "desktopName": "com.newida.nightfallvillage.desktop",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "test": "node --test tools/tests/server.test.js",
    "build": "npm run build:linux",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:windows": "electron-builder --win portable --x64",
    "package:dir": "electron-builder --dir"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.newida.nightfallvillage",
    "productName": "Nightfall Village",
    "copyright": "Copyright © 2026 Lukas Theißinger",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "src/desktop/**/*",
      "nightfall_village.html",
      "server.js",
      "package.json",
      "LICENSE",
      "LICENSING.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NightfallVillage-${version}-Windows-x64.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "syncDesktopName": true,
      "artifactName": "NightfallVillage-${version}-Linux-x64.${ext}"
    }
  }
}
